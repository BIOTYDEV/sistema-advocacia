# Crie um arquivo .env localmente com estas variáveis. 
# Na Vercel, cadastre-as no painel de Environment Variables.

PORT=3000
JWT_SECRET=sua_chave_secreta_aqui_bem_longa_e_complexa

# O JSON do Firebase deve ser colado em UMA ÚNICA LINHA (minificado)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"seu-projeto","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
